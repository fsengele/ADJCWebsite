@page
@model ADJCWebsite.Areas.Identity.Pages.Account.LoginModel
@{
    Layout = "/Areas/Identity/Pages/Account/_AuthLayout.cshtml";
    ViewData["Title"] = "Connexion";
    ViewData["AuthVerse"] = "Je suis le cep, vous êtes les sarments. Celui qui demeure en moi et en qui je demeure porte beaucoup de fruit, car sans moi vous ne pouvez rien faire.";
    ViewData["AuthReference"] = "Jean 15:5 — Louis Segond 1910";
    ViewData["AuthImage"] = "Arthur 2.jpeg";
    ViewData["AuthImageAlt"] = "Pasteur de l'ADJC portant un costume orange";
}

<div class="auth-page">
    <div class="auth-form-panel">
        <div class="auth-form-inner">
            <a class="auth-mobile-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="~/images/WhatsApp Image 2026-11-13 at 11.23.50 AM.jpeg" alt="Logo officiel de l'ADJC" />
                <span>ADJC</span>
            </a>
            <div class="auth-heading">
                <p class="auth-eyebrow">Espace membre</p>
                <h1>Heureux de vous revoir</h1>
                <p>Connectez-vous à votre espace ADJC.</p>
            </div>
            <form id="login-form" method="post" asp-route-returnUrl="@Model.ReturnUrl" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>
                <div class="auth-field">
                    <label asp-for="Input.Email"></label>
                    <div class="auth-input-wrap"><span class="auth-input-icon" aria-hidden="true">@@</span><input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus /><span class="auth-field-line"></span></div>
                    <span asp-validation-for="Input.Email" class="auth-validation"></span>
                </div>
                <div class="auth-field">
                    <div class="auth-label-row"><label asp-for="Input.Password"></label><a asp-page="./ForgotPassword">Mot de passe oublié ?</a></div>
                    <div class="auth-input-wrap"><span class="auth-input-icon" aria-hidden="true">●</span><input asp-for="Input.Password" class="form-control" autocomplete="current-password" data-password-input /><button type="button" class="password-toggle" data-password-toggle aria-label="Afficher le mot de passe">Afficher</button><span class="auth-field-line"></span></div>
                    <span asp-validation-for="Input.Password" class="auth-validation"></span>
                </div>
                <div class="auth-options"><label class="auth-check"><input asp-for="Input.RememberMe" /><span class="auth-checkmark"></span><span>Se souvenir de moi</span></label></div>
                <button type="submit" class="btn auth-submit" data-auth-submit><span data-submit-label>Se connecter</span><span data-submit-loading hidden>Connexion…</span><span aria-hidden="true">↗</span></button>
            </form>
            <p class="auth-switch">Vous n'avez pas encore de compte ? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Créer un compte</a></p>
            <a class="auth-back" href="@Url.Action("Index", "Home", new { area = "" })">← Retour au site</a>
        </div>
    </div>
    <div class="auth-visual-panel">
        @await Html.PartialAsync("_AuthVisual")
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
