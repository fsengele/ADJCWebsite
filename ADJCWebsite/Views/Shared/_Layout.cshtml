<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Assemblée des Disciples de Jésus-Christ — présenter et prêcher Jésus-Christ, l'unique espoir du salut de l'humanité." />
    <title>@ViewData["Title"] | ADJC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ADJCWebsite.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light site-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-3" asp-area="" asp-controller="Home" asp-action="Index" aria-label="ADJC, accueil">
                    <img src="~/images/WhatsApp Image 2026-11-13 at 11.23.50 AM.jpeg" alt="Logo officiel de l'ADJC" class="brand-logo" />
                    <span class="brand-name">Assemblée des Disciples<br class="d-none d-xl-block" /> de Jésus-Christ</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="Ouvrir le menu principal">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="discoverMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Découvrir</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Ministry" asp-action="Index">Notre Ministère</a></li>
                                <li><a class="dropdown-item" asp-controller="Vision" asp-action="Index">Vision</a></li>
                                <li><a class="dropdown-item" href="/#activites">Activités</a></li>
                                <li><a class="dropdown-item" asp-controller="Predications" asp-action="Index">Prédications</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="participateMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">Participer</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Rejoindre" asp-action="Index">Nous rejoindre</a></li>
                                <li><a class="dropdown-item" asp-controller="Servir" asp-action="Index">Servir avec nous</a></li>
                                <li><a class="dropdown-item" asp-controller="Contact" asp-action="Index">Contact</a></li>
                            </ul>
                        </li>
                    </ul>
                    <div class="navbar-actions d-lg-flex align-items-lg-center ms-lg-3">
                        <a class="btn btn-donate mt-3 mt-lg-0" asp-controller="Donate" asp-action="Index"><span aria-hidden="true">♥</span> Faire un don</a>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
            @RenderBody()
    </main>

    <footer class="site-footer" id="contact">
        <div class="container">
            <div class="row gy-5">
                <div class="col-lg-5">
                    <a class="footer-brand d-flex align-items-center gap-3" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/WhatsApp Image 2026-11-13 at 11.23.50 AM.jpeg" alt="Logo officiel de l'ADJC" class="footer-logo" />
                        <span>Assemblée des Disciples<br /> de Jésus-Christ</span>
                    </a>
                    <p class="footer-intro">Une communauté enracinée dans la Parole, la communion fraternelle et l'espérance en Jésus-Christ.</p>
                    <p class="footer-address">2–4 Chemin des Fourches<br />93380 Pierrefitte</p>
                </div>
                <div class="col-6 col-lg-3">
                    <h2 class="footer-title">Navigation</h2>
                    <ul class="footer-links list-unstyled">
                        <li><a href="/#accueil">Accueil</a></li>
                        <li><a asp-controller="Ministry" asp-action="Index">Notre Ministère</a></li>
                        <li><a asp-controller="Vision" asp-action="Index">Notre vision</a></li>
                        <li><a asp-controller="Rejoindre" asp-action="Index">Nous rejoindre</a></li>
                        <li><a asp-controller="Servir" asp-action="Index">Servir avec nous</a></li>
                        <li><a asp-controller="Donate" asp-action="Index">Faire un don</a></li>
                        <li><a asp-controller="Contact" asp-action="Index">Contact</a></li>
                        <li><a href="/#activites">Activités</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h2 class="footer-title">Restons connectés</h2>
                    <p class="footer-muted">Suivez l'ADJC sur les réseaux sociaux.</p>
                    <div class="social-links" aria-label="Réseaux sociaux">
                        <a class="social-link social-youtube" href="https://www.youtube.com/@@ev.arthurkiayinuaofficiel9560/videos" target="_blank" rel="noopener noreferrer" title="Chaîne YouTube officielle de l'ADJC" aria-label="Chaîne YouTube officielle de l'ADJC">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" /></svg>
                        </a>
                        <a class="social-link social-tiktok" href="https://www.tiktok.com/@@evarthurkiayinuao1?_r=1&amp;_t=ZN-9BinWEtKQCs" target="_blank" rel="noopener noreferrer" title="Compte TikTok officiel de l'ADJC" aria-label="Compte TikTok officiel de l'ADJC">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M16.6 5.8a5.6 5.6 0 0 0 3.3 1.1V3.5a3.4 3.4 0 0 1-1-.1 5.6 5.6 0 0 1-2.3-1.3A5.7 5.7 0 0 1 15.2 0h-3.4v16.4a3.3 3.3 0 1 1-2.3-3.2V9.7a6.7 6.7 0 1 0 5.7 6.7V8.1a9 9 0 0 0 5.2 1.7V6.4a5.7 5.7 0 0 1-3.8-.6Z" /></svg>
                        </a>
                        <a class="social-link social-facebook" href="https://www.facebook.com/share/1N7y3YkvnT/" target="_blank" rel="noopener noreferrer" title="Page Facebook officielle de l'ADJC" aria-label="Page Facebook officielle de l'ADJC">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.6 1.7-1.6h1.8V3.8c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.5v3h2.8v8h3.2Z" /></svg>
                        </a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year ADJC. Tous droits réservés.</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Confidentialité</a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
