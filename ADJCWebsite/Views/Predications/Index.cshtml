@{
    ViewData["Title"] = "Prédications";
    const string YouTubeChannelUrl = "https://www.youtube.com/@ev.arthurkiayinuaofficiel9560/videos";
}

<section class="predications-hero">
    <div class="container">
        <p class="eyebrow">La Parole pour aujourd'hui</p>
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <h1>Découvrez nos <span>enseignements.</span></h1>
                <p class="predications-hero-lead">Retrouvez les prédications et les enseignements du pasteur Arthur Kiayinua sur la chaîne officielle de l'ADJC.</p>
                <a class="btn btn-primary" href="@YouTubeChannelUrl" target="_blank" rel="noopener noreferrer">Voir toutes les prédications <span aria-hidden="true">↗</span></a>
            </div>
            <div class="col-lg-5">
                <div class="youtube-feature-card">
                    <div class="youtube-icon" aria-hidden="true">▶</div>
                    <p class="eyebrow">Chaîne officielle</p>
                    <h2>Pasteur Arthur Kiayinua</h2>
                    <p>Un espace pour écouter, apprendre et grandir dans la foi à travers des enseignements bibliques.</p>
                    <a class="youtube-text-link" href="@YouTubeChannelUrl" target="_blank" rel="noopener noreferrer">Accéder à la chaîne <span aria-hidden="true">→</span></a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding predications-info">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <p class="eyebrow">Un enseignement accessible</p>
                <h2>Grandir ensemble dans la connaissance de Dieu.</h2>
                <p>Consultez directement la chaîne YouTube officielle pour découvrir les contenus actuellement publiés par le ministère. Aucun titre, miniature ou lien de vidéo individuel n'est reproduit ici sans source officielle vérifiée.</p>
                <a class="btn btn-outline-primary mt-3" href="@YouTubeChannelUrl" target="_blank" rel="noopener noreferrer">Ouvrir YouTube <span aria-hidden="true">↗</span></a>
            </div>
        </div>
    </div>
</section>
